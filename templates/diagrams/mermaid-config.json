{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "SimSun, 宋体, Songti SC, serif",
    "fontSize": "24px",
    "primaryColor": "#FFFFFF",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#000000",
    "secondaryColor": "#F2F2F2",
    "secondaryTextColor": "#000000",
    "secondaryBorderColor": "#000000",
    "tertiaryColor": "#FFFFFF",
    "tertiaryTextColor": "#000000",
    "tertiaryBorderColor": "#000000",
    "lineColor": "#000000",
    "textColor": "#000000",
    "noteBkgColor": "#FFF9E6",
    "noteBorderColor": "#000000",
    "noteTextColor": "#000000",
    "edgeLabelBackground": "#FFFFFF",
    "clusterBkg": "#FFFFFF",
    "clusterBorder": "#000000"
  },
  "flowchart": {
    "curve": "linear",
    "padding": 10,
    "nodeSpacing": 40,
    "rankSpacing": 40,
    "htmlLabels": true
  },
  "sequence": {
    "actorMargin": 60,
    "messageMargin": 30,
    "boxMargin": 8
  },
  "themeCSS": ".nodeLabel, .edgeLabel, text, .label { font-family: SimSun, 宋体, Songti SC, serif !important; }"
}
